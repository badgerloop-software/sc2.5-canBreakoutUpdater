cd <path_to_zephyrproject>
activate python venv
cd zephyr

# -p does a clean build
---------------------------------------------------------------------------------------------------
west build -b -p <board_name> --sysbuild <path_to_app> --build-dir <path_to_app>/build -- -DBOARD_ROOT=<absolute_path_to_app>

OR

west config build.cmake-args -- "-DBOARD_ROOT=<absolute_path_to_app>"
west build -b -p <board_name> --sysbuild <path_to_app> --build-dir <path_to_app>/build
---------------------------------------------------------------------------------------------------

west flash -d <path_to_app>/build --skip-rebuild
